{
  "name": "pi-interactive-subagents",
  "version": "3.7.2",
  "description": "Interactive subagents for pi - spawn, orchestrate, and manage sub-agent sessions in tmux",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "Amos Blomqvist",
  "repository": {
    "type": "git",
    "url": "https://github.com/amosblomqvist/pi-interactive-subagents"
  },
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.ts test/test.ts",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.ts",
    "test:cli-integration": "node --test test/integration/external-cli.test.ts",
    "test:package-install": "node --test test/packaging/install.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./pi-extension/subagents/index.ts"
    ],
    "skills": [
      "./skills/workflow-authoring"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "typebox": "1.3.27"
  },
  "dependencies": {
    "@earendil-works/pi-codemode": "1.4.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
